  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "managerToken",
      "value": ""
    },
    {
      "key": "employeeToken",
      "value": ""
    },
    {
      "key": "createdUserId",
      "value": ""
    },
    {
      "key": "createdAdminId",
      "value": ""
    },
    {
      "key": "createdTaskId",
      "value": ""
    },
    {
      "key": "manager2Token",
      "value": ""
    },
    {
      "key": "employee2Token",
      "value": ""
    }
  ],
  "item": [
