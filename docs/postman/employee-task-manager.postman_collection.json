    {
      "name": "Dashboard",
      "description": "Use fresh role tokens. Compare totalTasks with task-list totalElements for the same account. Manual CRUD can change baseline seed counts.",
      "item": [
        {
          "name": "ADMIN global counts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/dashboard/stats"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status\", function () { pm.response.to.have.status(200); });",
                  "const d = pm.response.json();",
                  "pm.test(\"Counts agree\", function () { pm.expect(d.totalTasks).to.eql(d.tasksByStatus.pending + d.tasksByStatus.inProgress + d.tasksByStatus.done); pm.expect(d.completedTasks).to.eql(d.tasksByStatus.done); });"
                ]
              }
            }
          ]
        },
        {
          "name": "MANAGER own counts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/dashboard/stats"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status\", function () { pm.response.to.have.status(200); });",
                  "const d = pm.response.json();",
                  "pm.test(\"Counts agree\", function () { pm.expect(d.totalTasks).to.eql(d.tasksByStatus.pending + d.tasksByStatus.inProgress + d.tasksByStatus.done); pm.expect(d.completedTasks).to.eql(d.tasksByStatus.done); });",
                  "pm.test(\"No global user totals\", function () { pm.expect(d).not.to.have.property(\"totalUsers\"); pm.expect(d).not.to.have.property(\"activeUsers\"); });"
                ]
              }
            }
          ]
        },
