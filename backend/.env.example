# Reference only. Export values into your shell or hosting environment.
# Spring Boot does not automatically load this file or a .env file.
PORT=8080
DB_HOST=your-service-host.aivencloud.com
DB_PORT=your-service-port
DB_NAME=taskdb
DB_USERNAME=etm_app
DB_PASSWORD=your-etm-app-password
DB_TRUSTSTORE_URL=file:///absolute/path/to/aiven-truststore.p12
DB_TRUSTSTORE_PASSWORD=your-truststore-password
JWT_SECRET=generate-at-least-32-random-bytes-and-base64-encode-them
JWT_ISSUER=employee-task-manager
JWT_EXPIRATION_SECONDS=1800
CORS_ALLOWED_ORIGINS=http://localhost:4200
